<Window x:Class="FontBook.Workbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="字体工作台" Icon="/FontWorkbench;component/Assets/Workbench.ico"
        Width="1240" Height="800" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WorkbenchSurfaceBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="{DynamicResource WorkbenchTextRenderingMode}"
        RenderOptions.ClearTypeHint="{DynamicResource WorkbenchClearTypeHint}"
        AutomationProperties.Name="字体资产工作台主窗口">
    <Window.Resources>
        <ResourceDictionary Source="Palette.xaml" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="144" />
                <ColumnDefinition x:Name="LibraryColumn" Width="2*" MinWidth="220" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition x:Name="InspectorColumn" Width="3*" MinWidth="390" />
            </Grid.ColumnDefinitions>

            <Border x:Name="NavigationPane" Background="{DynamicResource WorkbenchSurfaceBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="字体工作台" FontWeight="SemiBold" FontSize="16" Margin="4,2,0,8" />
                        <Button x:Name="AllButton" Content="本机字体" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="28"
                                ToolTip="显示本机已安装字体" AutomationProperties.Name="查看全部已安装字体" />
                        <Button x:Name="FilesButton" Content="免安装预览…" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="28" Margin="0,3,0,0"
                                ToolTip="只读打开本地字体文件，不注册到 Windows" AutomationProperties.Name="打开字体文件免安装预览" />
                    </StackPanel>
                    <DockPanel Grid.Row="1" Margin="0,12,0,3">
                        <Button x:Name="NewShelfButton" DockPanel.Dock="Right" Content="+" Width="26" Height="26" MinWidth="0" Padding="0"
                                ToolTip="新建字体清单" AutomationProperties.Name="新建字体清单" />
                        <TextBlock Text="字体清单" Margin="4,0,0,0" Style="{StaticResource SectionLabelTextStyle}" />
                    </DockPanel>
                    <ListBox x:Name="ShelfList" Grid.Row="2" Padding="0" SelectionMode="Single"
                             Background="{DynamicResource WorkbenchSurfaceBrush}" ItemContainerStyle="{DynamicResource WorkbenchListBoxItemStyle}"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                             KeyboardNavigation.DirectionalNavigation="Contained" AutomationProperties.Name="字体清单列表">
                        <ListBox.Resources>
                            <Thickness x:Key="ListBoxItemPadding">6,1</Thickness>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="3" Margin="0,6,0,0">
                        <TextBlock x:Name="ShelfHint" Margin="3,0,3,5" Text="可新建清单，把当前字体归类整理。"
                                   Style="{StaticResource SectionLabelTextStyle}" TextWrapping="Wrap" MaxHeight="38"
                                   AutomationProperties.Name="字体清单提示" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Button x:Name="RenameShelfButton" Content="重命名" HorizontalAlignment="Stretch" Height="26" Padding="4,0" Margin="0,0,2,0"
                                    ToolTip="重命名当前字体清单" AutomationProperties.Name="重命名当前字体清单" />
                            <Button x:Name="DeleteShelfButton" Content="删除" HorizontalAlignment="Stretch" Height="26" Padding="4,0" Margin="2,0,0,0"
                                    ToolTip="删除当前字体清单" AutomationProperties.Name="删除当前字体清单" />
                        </UniformGrid>
                        <Button x:Name="SessionButton" Content="会话试用" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="28"
                                ToolTip="临时提供或释放本次会话试用的字体" AutomationProperties.Name="管理本次会话临时启用的字体" />
                        <Button x:Name="LegacyButton" Content="安全操作中心" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource WorkbenchSurfaceBrush}" Padding="8,6,8,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button x:Name="NavToggleButton" DockPanel.Dock="Left" Width="30" Height="28" MinWidth="0" Padding="0" Margin="0,0,6,0"
                                ToolTip="折叠导航栏" AutomationProperties.Name="折叠导航栏">
                            <Path Data="M 0,1.5 H 13 M 0,6.5 H 13 M 0,11.5 H 13" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="RetryButton" DockPanel.Dock="Right" Content="重试" Height="28" Padding="7,0" Margin="4,0,0,0" Visibility="Collapsed"
                                ToolTip="重新读取字体资产" AutomationProperties.Name="重试加载字体" />
                        <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新" Height="28" Padding="7,0" Margin="5,0,0,0"
                                ToolTip="重新读取本机字体资产（F5）" AutomationProperties.Name="重新扫描字体" />
                        <Grid>
                            <TextBox x:Name="SearchBox" MinWidth="0" MinHeight="0" Height="28" Padding="6,2" VerticalContentAlignment="Center"
                                     ToolTip="搜索字体名称、家族或样式（Ctrl+F）" AutomationProperties.Name="搜索字体"
                                     AutomationProperties.HelpText="输入字体家族名称或本地化别名" />
                            <TextBlock Text="搜索字体…" Margin="8,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=SearchBox}" Value="" />
                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                    <ListBox x:Name="FamilyList" Grid.Row="1" Margin="0,4,0,0" SelectionMode="Extended" Padding="0"
                             Background="{DynamicResource WorkbenchSurfaceBrush}" ItemContainerStyle="{DynamicResource WorkbenchListBoxItemStyle}"
                             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                             KeyboardNavigation.DirectionalNavigation="Contained" AutomationProperties.Name="字体家族列表"
                             AutomationProperties.HelpText="方向键浏览；用 Shift 或 Ctrl 扩展选择">
                        <ListBox.Resources>
                            <Thickness x:Key="ListBoxItemPadding">8,1</Thickness>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Margin="0,0,8,0" VerticalAlignment="Center"
                                               FontWeight="SemiBold" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding CompactDetail}" VerticalAlignment="Center" FontSize="12"
                                               Typography.NumeralAlignment="Tabular" ToolTip="{Binding Detail}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter x:Name="InspectorSplitter" Grid.Column="2" Width="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                          Padding="0" KeyboardIncrement="16" DragIncrement="1" Focusable="True" IsTabStop="True"
                          FocusVisualStyle="{DynamicResource DefaultControlFocusVisualStyle}"
                          ToolTip="拖动调整详情宽度，也可用左右方向键"
                          AutomationProperties.Name="调整字体详情栏宽度" AutomationProperties.HelpText="使用左右方向键调整宽度" />

            <Grid Grid.Column="3" Margin="2,8,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,5">
                    <Button x:Name="FontInfoButton" DockPanel.Dock="Right" Content="字体信息…" Height="28" Margin="6,0,0,0" Padding="7,0" IsEnabled="False"
                            AutomationProperties.Name="查看字面详细信息" />
                    <TextBlock x:Name="FamilyTitle" Text="尚未选择字体" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" AutomationProperties.Name="当前字体家族" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </DockPanel>
                <DockPanel Grid.Row="1" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Text="样式" Margin="0,0,7,0" Style="{StaticResource SectionLabelTextStyle}" />
                    <Button x:Name="GlyphBrowserButton" DockPanel.Dock="Right" Content="字形…" Height="28" Padding="7,0" Margin="5,0,0,0"
                            ToolTip="浏览当前样式的全部字形（GID / Ctrl+G）" AutomationProperties.Name="浏览当前样式的字形" />
                    <Button x:Name="ToggleMemberButton" DockPanel.Dock="Right" Content="加入清单" Height="28" Padding="7,0" Margin="5,0,0,0"
                            ToolTip="将当前字体加入所选字体清单" AutomationProperties.Name="将当前字体加入清单" />
                    <ComboBox x:Name="FacePicker" DisplayMemberPath="Name" Height="28" MinHeight="0" MaxDropDownHeight="300"
                              HorizontalContentAlignment="Stretch" ItemContainerStyle="{DynamicResource WorkbenchComboBoxItemStyle}"
                              AutomationProperties.Name="选择字体样式" ToolTip="选择当前字体家族的样式" />
                </DockPanel>

                <Border Grid.Row="2" Background="{DynamicResource WorkbenchSurfaceBrush}"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="7,5">
                            <TextBlock DockPanel.Dock="Left" Text="字号" Margin="0,0,7,0" Style="{StaticResource SectionLabelTextStyle}" />
                            <Button x:Name="OpenTypeButton" DockPanel.Dock="Right" Content="OpenType…" Height="28" Padding="7,0" Margin="5,0,0,0" IsEnabled="False"
                                    ToolTip="查看并设置当前字体的 OpenType 特性" AutomationProperties.Name="OpenType 排版特性" />
                            <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="标本设置" Height="28" Padding="7,0" Margin="5,0,0,0"
                                    AutomationProperties.Name="打开标本设置" />
                            <TextBlock x:Name="SizeText" DockPanel.Dock="Right" Text="38 pt" Width="40" Margin="4,0,2,0" TextAlignment="Right"
                                       Style="{StaticResource SectionLabelTextStyle}" AutomationProperties.Name="当前标本字号" />
                            <Slider x:Name="SizeSlider" Minimum="12" Maximum="96" Value="38" SmallChange="1" LargeChange="6" TickFrequency="1"
                                    IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                    AutomationProperties.Name="标本字号" AutomationProperties.HelpText="使用方向键调整字号，范围 12 到 96 点" />
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" Margin="7,0,7,4" MaxHeight="80" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Focusable="True"
                                      Visibility="{Binding Visibility, ElementName=AxisPanel}"
                                      FocusVisualStyle="{DynamicResource DefaultControlFocusVisualStyle}" AutomationProperties.Name="可变轴设置">
                            <StackPanel x:Name="AxisPanel" Visibility="Collapsed" />
                        </ScrollViewer>

                        <Border x:Name="SpecimenViewport" Grid.Row="2" Margin="7,0" Background="{DynamicResource WorkbenchSurfaceBrush}"
                                Padding="0" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="SpecimenImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
                                       IsHitTestVisible="False" AutomationProperties.Name="当前字体原生渲染标本" />
                                <Canvas x:Name="EditOverlay" IsHitTestVisible="False" />
                                <TextBox x:Name="SampleBox" Text="永 字 Aa 123" Template="{StaticResource SpecimenInputTemplate}"
                                         Foreground="Transparent" SelectionBrush="Transparent" SelectionTextBrush="Transparent" SelectionOpacity="0"
                                         CaretBrush="Transparent" Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" MinHeight="0"
                                         HorizontalContentAlignment="Left" VerticalContentAlignment="Top" AcceptsReturn="True" AcceptsTab="False"
                                         TextWrapping="Wrap" IsUndoEnabled="True" MaxLength="2048" SpellCheck.IsEnabled="False" InputMethod.IsInputMethodEnabled="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         FocusVisualStyle="{DynamicResource DefaultControlFocusVisualStyle}"
                                         AutomationProperties.Name="编辑字体标本文字" />
                                <TextBlock x:Name="PreviewNote" Text="选择字体后，这里会显示由字体文件生成的真实标本。"
                                           IsHitTestVisible="False" Margin="2" MaxWidth="420" HorizontalAlignment="Left" VerticalAlignment="Top"
                                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                           AutomationProperties.Name="标本预览状态" AutomationProperties.LiveSetting="Polite">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source, ElementName=SpecimenImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <DockPanel Grid.Row="3" Margin="7,4">
                            <TextBlock DockPanel.Dock="Left" Text="字符覆盖" Margin="0,0,7,0" Style="{StaticResource SectionLabelTextStyle}" />
                            <Button x:Name="CopyMissingButton" DockPanel.Dock="Right" Content="复制缺字" Height="26" Padding="6,0" Margin="6,0,0,0"
                                    ToolTip="复制当前标本缺失字符的码点" AutomationProperties.Name="复制标本缺字码点" />
                            <TextBlock x:Name="CoverageText" Text="—" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionLabelTextStyle}"
                                       AutomationProperties.Name="标本字符覆盖" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </DockPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="字面信息" Margin="0,0,7,0" Style="{StaticResource SectionLabelTextStyle}" />
                    <ScrollViewer Grid.Column="1" MaxHeight="34" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Focusable="True" FocusVisualStyle="{DynamicResource DefaultControlFocusVisualStyle}" AutomationProperties.Name="字体元数据滚动区域">
                        <TextBlock x:Name="FaceDetail" Text="选择字体系列后查看样式与格式" FontSize="12" TextWrapping="Wrap"
                                   AutomationProperties.Name="当前字体样式详情" />
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" Text="文件路径" Margin="0,3,7,0" Style="{StaticResource SectionLabelTextStyle}" />
                    <TextBlock x:Name="PathText" Visibility="Collapsed" Text="未选择字体文件" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3,0,0" Text="{Binding Text, ElementName=PathText, Mode=OneWay}"
                             IsReadOnly="True" IsReadOnlyCaretVisible="True" FontSize="12" MinHeight="0" Height="26" Padding="5,1" VerticalContentAlignment="Center"
                             AutomationProperties.Name="字体文件路径" AutomationProperties.HelpText="按 Ctrl+A 选择完整路径，再按 Ctrl+C 复制">
                        <TextBox.ToolTip>
                            <ToolTip Content="{Binding PlacementTarget.Text, RelativeSource={RelativeSource Self}}" ContentTemplate="{StaticResource FullTextToolTipTemplate}" />
                        </TextBox.ToolTip>
                    </TextBox>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Padding="8,3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MaxWidth="112" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MaxWidth="210" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ScopeTitle" Text="已安装字体" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" AutomationProperties.Name="当前字体范围" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <ComboBox x:Name="ViewPicker" Grid.Column="1" Width="88" MinHeight="0" Height="28" Padding="5,1" Margin="8,0"
                          MaxDropDownHeight="240" ItemContainerStyle="{DynamicResource WorkbenchComboBoxItemStyle}"
                          ToolTip="切换字体库视图" AutomationProperties.Name="字体库视图" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BatchDisableButton" Content="停用…" Height="28" Padding="6,0" Margin="0,0,3,0" IsEnabled="False"
                            ToolTip="停用选中的字体" AutomationProperties.Name="停用选中的字体" />
                    <Button x:Name="BatchEnableButton" Content="恢复…" Height="28" Padding="6,0" Margin="0,0,3,0" IsEnabled="False"
                            ToolTip="查看历史并恢复字体" AutomationProperties.Name="恢复选中的字体" />
                    <Button x:Name="BatchUninstallButton" Content="卸载…" Height="28" Padding="6,0" IsEnabled="False"
                            ToolTip="卸载选中的字体" AutomationProperties.Name="卸载选中的字体" />
                </StackPanel>
                <TextBlock x:Name="ResultText" Grid.Column="3" Text="正在准备字体资产" Margin="9,0,0,0"
                           Style="{StaticResource SectionLabelTextStyle}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="字体列表状态" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <TextBlock x:Name="StatusText" Grid.Column="4" Text="就绪" Margin="9,0,0,0" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource SectionLabelTextStyle}" AutomationProperties.Name="工作台状态" AutomationProperties.LiveSetting="Polite"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <TextBlock Grid.Column="5" Text="外观" Margin="6,0,6,0" Style="{StaticResource SectionLabelTextStyle}" />
                <ComboBox x:Name="ThemePicker" Grid.Column="6" Width="108" Height="28" MinHeight="0" Padding="6,1" SelectedIndex="0"
                          ItemContainerStyle="{DynamicResource WorkbenchComboBoxItemStyle}"
                          ToolTip="仅更改字体工作台；Windows 高对比主题优先" AutomationProperties.Name="工作台外观主题"
                          AutomationProperties.HelpText="可跟随系统，或只为此应用指定浅色或深色；Windows 高对比优先">
                    <ComboBoxItem HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Content="跟随系统" />
                    <ComboBoxItem HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Content="浅色" />
                    <ComboBoxItem HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Content="深色" />
                </ComboBox>
            </Grid>
        </Border>
    </Grid>
</Window>
