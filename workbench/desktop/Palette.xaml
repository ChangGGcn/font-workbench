<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, 微软雅黑</FontFamily>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

    <Style x:Key="SectionLabelTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <DataTemplate x:Key="FullTextToolTipTemplate">
        <TextBlock Text="{Binding}" MaxWidth="460" TextWrapping="Wrap" />
    </DataTemplate>

    <!-- The stock Fluent TextBox paints its own foreground/background on focus. The specimen
         uses DirectWrite instead, so leave only the native text host (input, undo and IME). -->
    <ControlTemplate x:Key="SpecimenInputTemplate" TargetType="TextBox">
        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                      Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" />
    </ControlTemplate>
</ResourceDictionary>
