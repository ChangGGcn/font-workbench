<Window x:Class="FontBook.Workbench.GlyphWindow" x:ClassModifier="internal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="字形浏览器" Width="748" Height="522" MinWidth="650" MinHeight="418"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{DynamicResource UiFontFamily}" FontSize="12"
        Background="{DynamicResource WorkbenchSurfaceBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="{DynamicResource WorkbenchTextRenderingMode}" RenderOptions.ClearTypeHint="{DynamicResource WorkbenchClearTypeHint}">
    <Window.Resources>
        <ResourceDictionary Source="Palette.xaml" />
    </Window.Resources>
    <Border Padding="10,7">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="GlyphTitle" Margin="0,0,0,5" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,5" LastChildFill="False">
            <TextBlock Text="跳转" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="GlyphJumpBox" Width="128" MinHeight="25" Padding="4,1" VerticalContentAlignment="Center" MaxLength="16"
                     ToolTip="十进制 GID 或 U+ 十六进制码点" AutomationProperties.Name="输入十进制 GID 或 U+ 码点"/>
            <Button x:Name="GlyphJumpButton" Content="转到" Padding="9,2" Margin="3,0,4,0" AutomationProperties.Name="转到字形"/>
            <TextBlock VerticalAlignment="Center" Text="如 48 或 U+0041" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Button x:Name="GlyphNextButton" DockPanel.Dock="Right" Content="下一页 ›" Padding="8,2" AutomationProperties.Name="下一页字形"/>
            <Button x:Name="GlyphPrevButton" DockPanel.Dock="Right" Content="‹ 上一页" Padding="8,2" Margin="0,0,3,0" AutomationProperties.Name="上一页字形"/>
            <TextBlock x:Name="GlyphPageText" DockPanel.Dock="Right" Margin="4,0,7,0" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="176"/></Grid.ColumnDefinitions>
            <ListBox x:Name="GlyphList" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="False" VirtualizingPanel.IsVirtualizing="False" Padding="1" Background="{DynamicResource WorkbenchSurfaceBrush}" AutomationProperties.Name="当前页字形">
                <!-- At most 48 items are allocated per page; no element or image per font-wide GID. -->
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="60" ItemHeight="56"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="1"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationLabel}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate>
                    <Grid Height="52" ToolTip="{Binding Description}">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="16"/></Grid.RowDefinitions>
                        <Image Width="32" Height="32" Source="{Binding Image}" Stretch="Uniform"/>
                        <TextBlock Grid.Row="1" Text="{Binding Gid}" FontSize="10" HorizontalAlignment="Center"/>
                    </Grid>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer Grid.Column="1" Margin="9,0,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="所选字形" FontWeight="SemiBold"/>
                    <Image x:Name="GlyphSelectedImage" Width="120" Height="120" Stretch="Uniform" Margin="0,4" AutomationProperties.Name="精确 GID 的放大图"/>
                    <TextBlock x:Name="GlyphDetails" TextWrapping="Wrap" Margin="0,0,0,9"/>
                    <TextBlock Text="直接 Unicode 映射" Margin="0,0,0,3"/>
                    <ComboBox x:Name="GlyphScalarBox" DisplayMemberPath="Label" IsTextSearchEnabled="True" MaxDropDownHeight="180" ItemContainerStyle="{DynamicResource WorkbenchComboBoxItemStyle}" AutomationProperties.Name="选择字形的 Unicode 映射"/>
                    <StackPanel x:Name="AliasPager" Visibility="Collapsed" Orientation="Horizontal" Margin="0,3,0,0">
                        <Button x:Name="AliasPrevious" Content="‹" MinWidth="24" AutomationProperties.Name="上一组映射"/>
                        <TextBlock x:Name="AliasRange" VerticalAlignment="Center" Margin="4,0"/>
                        <Button x:Name="AliasNext" Content="›" MinWidth="24" AutomationProperties.Name="下一组映射"/>
                    </StackPanel>
                    <Button x:Name="GlyphCopyButton" Content="复制所选字符" ToolTip="复制选中映射的字符；控制字符和格式字符仅显示码点" Padding="6,3" Margin="0,5,0,0" AutomationProperties.Name="复制当前映射的实际字符"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <TextBlock Grid.Row="3" x:Name="GlyphStatus" MinHeight="23" Margin="0,4,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
    </Border>
</Window>
