<Window x:Class="FontBook.Workbench.ManagementDialog" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="748" Height="540" MinWidth="470" MinHeight="350" WindowStartupLocation="CenterOwner"
        TextOptions.TextRenderingMode="{DynamicResource WorkbenchTextRenderingMode}" RenderOptions.ClearTypeHint="{DynamicResource WorkbenchClearTypeHint}"
        ShowInTaskbar="False" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        Background="{DynamicResource WorkbenchSurfaceBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Window.Resources>
        <DataTemplate x:Key="ManagementRowTemplate">
            <StackPanel Margin="4,5">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Status}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Files}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Detail}" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="ManagementListStyle" TargetType="{x:Type ListBox}" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background" Value="{DynamicResource WorkbenchSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="ItemContainerStyle" Value="{DynamicResource WorkbenchListBoxItemStyle}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ItemTemplate" Value="{StaticResource ManagementRowTemplate}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="ManagementHeading" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="ManagementNotice" Grid.Row="1" Margin="0,7,0,12" TextWrapping="Wrap"/>
        <ListBox x:Name="ManagementHistoryList" Grid.Row="2" SelectionMode="Extended" Visibility="Collapsed"
                 Style="{StaticResource ManagementListStyle}" AutomationProperties.Name="字体操作历史，支持多选"/>
        <ListBox x:Name="ManagementItemsList" Grid.Row="2" Visibility="Collapsed" Style="{StaticResource ManagementListStyle}"
                 AutomationProperties.Name="逐项预检或操作结果"/>
        <StackPanel x:Name="SystemFontWarning" Grid.Row="3" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock x:Name="SystemFontWarningText" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <CheckBox x:Name="SystemFontAcknowledgement" Visibility="Collapsed" Margin="0,3,0,0"
                      Content="我了解卸载系统字体的风险"/>
        </StackPanel>
        <WrapPanel Grid.Row="4" Margin="0,14,0,0" HorizontalAlignment="Right">
            <StackPanel x:Name="CountGuard" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock x:Name="CountGuardHint" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="CountGuardText" Width="68" MaxLength="8" AutomationProperties.Name="再次输入批量操作项目数量"/>
            </StackPanel>
            <Button x:Name="ManagementCancelButton" Content="取消" IsCancel="True" MinWidth="88" Padding="10,5" Margin="0,0,8,0"/>
            <Button x:Name="ManagementReviewButton" Content="预检选中的记录" Visibility="Collapsed" MinWidth="132" Padding="10,5"/>
            <Button x:Name="ManagementAdminButton" Visibility="Collapsed" Content="以管理员身份重开并复核…" Padding="10,5" Margin="0,0,8,0"
                    ToolTip="本批只请求一次 Windows 授权。授权成功后关闭当前窗口以释放预览，再次确认后才会更改字体。"/>
            <Button x:Name="ManagementConfirmButton" Visibility="Collapsed" MinWidth="132" Padding="10,5"/>
        </WrapPanel>
    </Grid>
</Window>
