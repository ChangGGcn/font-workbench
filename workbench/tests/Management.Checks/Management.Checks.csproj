<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefaultItemExcludes>$(DefaultItemExcludes);Legacy/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../management/Management.csproj" />
    <ProjectReference Include="Legacy/Management.LegacyChecks.csproj" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="HiveFixture.ttf.b64" LogicalName="hive-fixture.b64" /><Compile Include="../PrivateFontHive.cs" Link="PrivateFontHive.cs"/></ItemGroup>
</Project>
