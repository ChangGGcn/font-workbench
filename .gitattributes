# 文本按内容自动识别；二进制不参与 diff/换行转换
* text=auto

*.png binary
*.ico binary
*.ttf binary
*.otf binary
*.ttc binary

*.cs   text diff=csharp
*.xaml text
*.ps1  text
*.csv  text

# Preserve upstream license text, including the original mingw-w64 notice spacing.
workbench/licenses/*.txt text eol=lf whitespace=-trailing-space
